---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Redes from "../components/Redes.astro";
import { site } from "../config/site";

const { latitude, longitude, rotulo } = site.mapa;
const mapaSrc = `https://maps.google.com/maps?q=${latitude},${longitude}(${encodeURIComponent(rotulo)})&z=15&output=embed`;
---

<BaseLayout
  title="CONTATO | Madeiras Capit"
  caminho="/contato"
  atual="contato"
  fundo="var(--color-cinza-claro)"
>
  <section class="bg-verde pt-[75px] pb-[52px]">
    <div class="mx-auto max-w-[980px] px-4 md:px-[23px]">
      <h1 class="text-[40px] leading-[1.4] font-bold text-white sm:text-[56px]">
        Contato
      </h1>

      <div class="mt-[40px] flex flex-col gap-x-10 gap-y-6 text-[16px] text-black md:flex-row">
        <div class="flex flex-col gap-[47px] md:w-[355px]">
          <p class="flex items-start gap-[26px] leading-[28.8px]">
            <Icon
              name="localizacao"
              class="mt-[3px] h-[29px] w-[21px] shrink-0"
              aria-hidden="true"
            />
            <span>{site.contato.enderecoCompleto}</span>
          </p>
          <p class="flex items-center gap-[26px] leading-[32px]">
            <Icon
              name="telefone"
              class="h-[24px] w-[25px] shrink-0"
              aria-hidden="true"
            />
            <span>{site.contato.telefoneContato}</span>
          </p>
        </div>
        <div class="flex flex-col gap-[40px] md:mt-[6px]">
          <p class="flex items-center gap-[36px] leading-[32px]">
            <Icon
              name="email"
              class="h-[16px] w-[25px] shrink-0"
              aria-hidden="true"
            />
            <a href={`mailto:${site.contato.email}`}>{site.contato.email}</a>
          </p>
          <div class="flex items-center gap-[32px]">
            <Icon
              name="curtir"
              class="h-[25px] w-[23px] shrink-0"
              aria-hidden="true"
            />
            <Redes variante="contato" />
          </div>
        </div>
      </div>

      <a
        href={site.whatsapp.url}
        target="_blank"
        rel="noreferrer noopener"
        aria-label="ENTRE EM CONTATO"
        class="bg-verde-escuro text-lima mt-[40px] inline-flex h-[67px] w-[327px] max-w-full items-center justify-center rounded-full text-[24px] font-black transition-opacity hover:opacity-90"
      >
        ENTRE EM CONTATO
      </a>
    </div>
  </section>

  <div class="bg-verde">
    <hr class="mx-auto w-[calc(100%-160px)] max-w-[1280px] border-0 border-t border-[#333]" />
  </div>

  <section class="bg-verde-escuro px-4 pt-[34px] pb-[30px] md:px-[80px]">
    <iframe
      title="Mapa"
      src={mapaSrc}
      class="block h-[350px] w-full max-w-[820px] border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </section>
</BaseLayout>
