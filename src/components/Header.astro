---
import { site } from "../config/site";
import { comBase } from "../config/caminho";
import type { IdNavegacao } from "../config/site";

interface Props {
  atual?: IdNavegacao;
}

const { atual } = Astro.props;
---

<header class="bg-verde-escuro border-azul-linha relative z-10 border-b-[3px] font-montserrat">
  <div class="mx-auto flex max-w-[980px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-2 md:flex-nowrap md:px-[28px] md:py-0">
    <a
      href={comBase("/")}
      class="text-[17px] leading-[44px] tracking-[-0.48px] whitespace-nowrap sm:text-[24px] md:leading-[62px]"
      aria-label={site.nomeMarca}
    >
      <span class="text-verde font-normal">{site.logo.parte1}</span>{" "}
      <span class="font-bold text-white">{site.logo.parte2}</span>
    </a>

    <nav
      aria-label="Site"
      class="order-3 flex w-full justify-center md:order-none md:w-auto"
    >
      <ul class="flex items-center">
        {site.navegacao.map((item) => (
          <li>
            <a
              href={comBase(item.href)}
              aria-current={atual === item.id ? "page" : undefined}
              class:list={[
                "block px-[18px] text-[10px] leading-[40px] hover:text-lima",
                atual === item.id ? "text-lima" : "text-white",
              ]}
            >
              {item.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={site.whatsapp.url}
      target="_blank"
      rel="noreferrer noopener"
      aria-label={site.botaoCabecalho}
      class="bg-lima text-verde-escuro inline-flex h-[34px] w-[120px] items-center justify-center rounded-full text-[18px] sm:h-[40px] sm:w-[158px] sm:text-[24px] leading-none font-black transition-opacity hover:opacity-90"
    >
      {site.botaoCabecalho}
    </a>
  </div>
</header>
